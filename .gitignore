# Unity generated
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Never ignore Asset Store Tools plugin folders that we depend on
/[Aa]ssets/AssetStoreTools*

# Autogenerated IDE / VS files
.vs/
.vsconfig
.idea/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Signing keys. The release keystore lives outside the repo (see Tools/release.sh) and this rule is
# only here to catch the day somebody generates one in the project directory by accident. A leaked
# signing key cannot be rotated — every future release has to be signed with the same one.
*.keystore
*.jks

# Crashlytics
crashlytics-build.properties

# Gradle cache
.gradle/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Generated geometry. Derived output of Tools > Horizon > Rebuild Prototype Scene — the terrain mesh
# alone is ~2.4 MB of YAML and would churn on every regeneration. After cloning, run the tool once;
# it regenerates these meshes and the scenes that reference them together.
/[Aa]ssets/_Project/Art/Models/Generated/

# Preview renders from Tools > Horizon > Render Car Preview
/CarPreview_*.png
/CoursePreview_*.png
/WorldPreview_*.png
/MapPreview_*.png
/HudPreview_*.png
/WeatherPreview_*.png

# Claude Code local settings
.claude/settings.local.json

# Generated IDE solution (Visual Studio Code Editor package)
*.slnx
.vscode/

# Burst debug symbols, emitted beside a player build. Named DoNotShip by Unity, and it means it.
/*_BurstDebugInformation_DoNotShip/
